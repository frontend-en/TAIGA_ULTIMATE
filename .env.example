# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=ru

# Lead form SMTP delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-secret
SMTP_FROM=SigmaBots <mailer@example.com>
LEAD_RECIPIENT=kristinarwebdev@gmail.com
# Enable only when the origin is private and the trusted ingress overwrites X-Real-IP.
# When false, the in-process fallback is intentionally a global 5 requests/minute limit.
LEAD_TRUST_PROXY=false
