# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=ru

# Lead form SMTP delivery through Brevo (SMTP & API > SMTP).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# false selects STARTTLS on port 587; the application still requires TLS.
SMTP_SECURE=false
# Copy the SMTP login and an SMTP key, not the account password or REST API key.
SMTP_USER=replace-with-brevo-smtp-login
SMTP_PASS=replace-with-brevo-smtp-key
# Replace with a sender address verified in Brevo.
SMTP_FROM=SigmaBots <mailer@example.com>
# Actual mailbox receiving accepted leads; Brevo relays the notification to it.
LEAD_RECIPIENT=kristinarwebdev@gmail.com
# Enable only when the origin is private and the trusted ingress overwrites X-Real-IP.
# When false or unavailable, only the process-wide limits apply (no spoofable IP bucket).
LEAD_TRUST_PROXY=false

# MCP-КЛЮЧ ДЛЯ АССИСТЕНТА CODEX: управление Brevo и просмотр доставки.
# Само подключение MCP настраивается отдельно в Codex.
# Форма отправляет письма через SMTP_USER / SMTP_PASS выше.
BREVO_MCP=
BREVO_MCP_CODEX=

# Lead security: server-side secrets; never use NEXT_PUBLIC_ for these values.
LEAD_REVIEW_RECIPIENT=review@example.com
TYPESAFE_API_KEY=
LEAD_AI_MODEL=jev-1.14.0
# Reject high-confidence spam/manipulation. Use observe explicitly for calibration.
LEAD_AI_MODE=enforce
# Optional: defaults to a cryptographically random secret generated per process.
# LEAD_HMAC_SECRET=

# Local per-process limits (positive integers; reset when Node.js restarts).
LEAD_IP_MINUTE_LIMIT=5
LEAD_IP_DAY_LIMIT=30
LEAD_GLOBAL_MINUTE_LIMIT=60
LEAD_GLOBAL_DAY_LIMIT=1000
LEAD_AI_DAY_LIMIT=500
